{
    "openapi": "3.0.0",
    "info": {
        "title": "SenaVida API",
        "description": "API REST del backend de SenaVida, plataforma de comunicacion inclusiva para personas sordas en contextos de urgencia medica.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000/api/v1",
            "description": "Servidor local de desarrollo"
        }
    ],
    "paths": {
        "/auth/login": {
            "post": {
                "tags": [
                    "Autenticacion"
                ],
                "summary": "Iniciar sesion",
                "description": "Autentica a un usuario con email y password. Devuelve un token Bearer de Sanctum que debe usarse en las peticiones siguientes.",
                "operationId": "985cd5203e2d0a820e113f2f4fdb2847",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "superadmin@test.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login exitoso, devuelve el token"
                    },
                    "422": {
                        "description": "Credenciales incorrectas"
                    },
                    "429": {
                        "description": "Demasiados intentos fallidos"
                    }
                }
            }
        },
        "/auth/me": {
            "get": {
                "tags": [
                    "Autenticacion"
                ],
                "summary": "Obtener usuario autenticado",
                "description": "Devuelve los datos del usuario dueño del token enviado. Sirve para verificar si la sesion sigue siendo valida.",
                "operationId": "e339e0e74860c0647fd1d41bbbbc13b2",
                "responses": {
                    "200": {
                        "description": "Datos del usuario autenticado"
                    },
                    "401": {
                        "description": "Token invalido, expirado o revocado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/auth/logout": {
            "post": {
                "tags": [
                    "Autenticacion"
                ],
                "summary": "Cerrar sesion",
                "description": "Revoca el token actual en el servidor. Despues de esto, el token queda inservible de inmediato.",
                "operationId": "a05022a34eef599e04fb0a5254375b84",
                "responses": {
                    "200": {
                        "description": "Sesion cerrada, token revocado"
                    },
                    "401": {
                        "description": "Token invalido o ya revocado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/health-centers": {
            "get": {
                "tags": [
                    "Catalogos"
                ],
                "summary": "Listar centros de salud",
                "description": "Devuelve todos los centros de salud, cada uno con el organizationId al que pertenece.",
                "operationId": "e6113ab27f80363bef8ef14dfdbaeaf6",
                "responses": {
                    "200": {
                        "description": "Listado de centros de salud"
                    },
                    "401": {
                        "description": "No autenticado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Catalogos"
                ],
                "summary": "Crear centro de salud",
                "description": "Crea un nuevo centro de salud dentro de una organizacion. Solo el super_admin puede hacerlo.",
                "operationId": "83dad474f975758ae3e15710a853de44",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "organizationId"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Hospital San Rafael"
                                    },
                                    "organizationId": {
                                        "type": "string",
                                        "format": "uuid"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Centro de salud creado"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "403": {
                        "description": "Solo super_admin puede crear centros"
                    },
                    "422": {
                        "description": "Datos invalidos"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/organizations": {
            "get": {
                "tags": [
                    "Catalogos"
                ],
                "summary": "Listar organizaciones",
                "description": "Devuelve todas las organizaciones de salud registradas en el sistema.",
                "operationId": "212e7ae65bac93ef8fe7a173dd8c21ed",
                "responses": {
                    "200": {
                        "description": "Listado de organizaciones"
                    },
                    "401": {
                        "description": "No autenticado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Catalogos"
                ],
                "summary": "Crear organizacion",
                "description": "Crea una nueva organizacion de salud. Solo el super_admin puede hacerlo.",
                "operationId": "242e48fe4b9103f0f1d4b5a5859f95fd",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Servicio de Salud Metropolitano"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Organizacion creada"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "403": {
                        "description": "Solo super_admin puede crear organizaciones"
                    },
                    "422": {
                        "description": "Datos invalidos"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/units": {
            "get": {
                "tags": [
                    "Catalogos"
                ],
                "summary": "Listar unidades",
                "description": "Devuelve las unidades del sistema. Si se envia el parametro healthCenterId, filtra solo las de ese centro.",
                "operationId": "f1ee53f15b9381a8d3f28d8b6d5fa4cc",
                "parameters": [
                    {
                        "name": "healthCenterId",
                        "in": "query",
                        "description": "UUID del centro de salud para filtrar sus unidades (opcional)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Listado de unidades"
                    },
                    "401": {
                        "description": "No autenticado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Catalogos"
                ],
                "summary": "Crear unidad",
                "description": "Crea una unidad dentro de un centro de salud. El super_admin puede crearla en cualquier centro; el admin_institucional solo en el suyo.",
                "operationId": "60839c16039ec69ff8377a4da20528af",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "healthCenterId"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Urgencia Adulto"
                                    },
                                    "healthCenterId": {
                                        "type": "string",
                                        "format": "uuid"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Unidad creada"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "403": {
                        "description": "Sin permiso, o fuera del propio centro"
                    },
                    "422": {
                        "description": "Datos invalidos"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/users": {
            "get": {
                "tags": [
                    "Usuarios"
                ],
                "summary": "Listar usuarios",
                "description": "Devuelve los usuarios visibles para quien hace la peticion. El super_admin ve todos; el admin_institucional solo los de su propio centro de salud.",
                "operationId": "47249454f1cdb4ad92ff4dd2abad233f",
                "responses": {
                    "200": {
                        "description": "Listado de usuarios"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "403": {
                        "description": "Sin permiso para listar usuarios"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Usuarios"
                ],
                "summary": "Registrar un nuevo usuario",
                "description": "Crea un usuario del personal de salud. Solo super_admin o admin_institucional pueden hacerlo, y admin_institucional unicamente dentro de su propio centro de salud. La contrasena se cifra automaticamente con bcrypt.",
                "operationId": "4b986d733289251f0bcc4130dd815af2",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "password_confirmation",
                                    "role",
                                    "organizationId",
                                    "healthCenterId",
                                    "unitId"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Enfermera de Prueba"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "enfermera@test.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    },
                                    "role": {
                                        "type": "string",
                                        "example": "categorizacion",
                                        "enum": [
                                            "super_admin",
                                            "admin_institucional",
                                            "admision",
                                            "categorizacion",
                                            "medico"
                                        ]
                                    },
                                    "organizationId": {
                                        "type": "string",
                                        "format": "uuid"
                                    },
                                    "healthCenterId": {
                                        "type": "string",
                                        "format": "uuid"
                                    },
                                    "unitId": {
                                        "type": "string",
                                        "format": "uuid"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Usuario creado correctamente"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "403": {
                        "description": "Sin permiso, o intento de crear fuera del propio centro"
                    },
                    "422": {
                        "description": "Datos invalidos o email duplicado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/users/{id}": {
            "get": {
                "tags": [
                    "Usuarios"
                ],
                "summary": "Ver un usuario",
                "description": "Devuelve el detalle de un usuario. El admin_institucional solo puede ver usuarios de su propio centro.",
                "operationId": "90ca44c038360e66084588a1a5951520",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "UUID del usuario",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Datos del usuario"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "403": {
                        "description": "Sin permiso para ver este usuario"
                    },
                    "404": {
                        "description": "Usuario no encontrado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Usuarios"
                ],
                "summary": "Editar un usuario",
                "description": "Actualiza los datos de un usuario. El admin_institucional solo puede editar usuarios de su propio centro.",
                "operationId": "e734c66a7d375609edee2154bc5f7b47",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "UUID del usuario",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Enfermera Actualizada"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "nueva@test.com"
                                    },
                                    "role": {
                                        "type": "string",
                                        "enum": [
                                            "super_admin",
                                            "admin_institucional",
                                            "admision",
                                            "categorizacion",
                                            "medico"
                                        ]
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "nuevaClave123"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "nuevaClave123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Usuario actualizado"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "403": {
                        "description": "Sin permiso para editar este usuario"
                    },
                    "404": {
                        "description": "Usuario no encontrado"
                    },
                    "422": {
                        "description": "Datos invalidos"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Usuarios"
                ],
                "summary": "Desactivar un usuario",
                "description": "Marca al usuario como inactivo (isActive=false). No elimina el registro de la base de datos.",
                "operationId": "9daa558fb80f5a3e2b490a3a5b05a716",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "UUID del usuario",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Usuario desactivado"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "403": {
                        "description": "Sin permiso, o intento de autodesactivacion"
                    },
                    "404": {
                        "description": "Usuario no encontrado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "description": "Token Bearer obtenido en /auth/login",
                "bearerFormat": "Sanctum Token",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Autenticacion",
            "description": "Autenticacion"
        },
        {
            "name": "Catalogos",
            "description": "Catalogos"
        },
        {
            "name": "Usuarios",
            "description": "Usuarios"
        }
    ]
}